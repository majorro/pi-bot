{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Information"
    }
  },
  "BotConfiguration": {
    "Token": "${PI_BOT_TG_TOKEN}",
    "HostAddress": "${PI_BOT_TG_URL}",
    "Route": "/api/tg-webhook",
    "SecretToken": "${PI_BOT_TG_SECRET}"
  },
  "PgConfig": {
    "Host": "${PI_BOT_DB_HOST}",
    "Port": "${PI_BOT_DB_PORT}",
    "Username": "${PI_BOT_DB_USER}",
    "Password": "${PI_BOT_DB_PASSWORD}"
  }
}
