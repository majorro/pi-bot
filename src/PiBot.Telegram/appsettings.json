{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "BotConfiguration": {
    "Token": "${PI_BOT_TG_TOKEN}"
  },
  "TelegramPgConfig": {
    "Host": "${PI_BOT_DB_HOST}",
    "Port": "${PI_BOT_DB_PORT}",
    "Username": "${PI_BOT_DB_USER}",
    "Password": "${PI_BOT_DB_PASSWORD}"
  },
  "ReadonlyPgConfig": {
    "Host": "${PI_BOT_DB_HOST}",
    "Port": "${PI_BOT_DB_PORT}",
    "Username": "${PI_BOT_DB_USER}",
    "Password": "${PI_BOT_DB_PASSWORD}"
  }
}
